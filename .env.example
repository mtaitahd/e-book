APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database

# Abliner payment collection (keep both secrets server-side)
ABLINER_BASE_URL=https://abliner.net
ABLINER_API_KEY=
ABLINER_WEBHOOK_SECRET=
ABLINER_WEBHOOK_URL=
ABLINER_ENABLED=true
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Purchase receipts are sent inline by default (sync), so a receipt is never
# stranded in a queue with no worker running. Failed deliveries are recorded in
# the email_notifications table and re-sent the next time the same order is
# confirmed. Set this to database only if a `queue:work` supervisor is running.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Customer email (purchase receipts and payment failure notices).
#
# MAIL_MAILER=log writes the rendered message to storage/logs/laravel.log and is
# the safe default: no message can leave the server, and no credential is needed.
# Set MAIL_MAILER=smtp and fill in the placeholders below on a real deployment.
# MAIL_SCHEME is how Laravel 12 expresses encryption: leave it null for plain
# SMTP over STARTTLS, or set it to smtps for an implicit-TLS port such as 465.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# MAIL_URL=smtp://user:pass@mail.example.com:587   (alternative to the fields above)
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The currency the shop charges in. Mobile Money is only offered to orders
# placed in this currency, so it must match the prices shown in the storefront.
SHOP_CURRENCY=TZS

# ---------------------------------------------------------------------------
# Abliner Payments
# ---------------------------------------------------------------------------
# These are the FALLBACK values. An administrator can set, rotate, reveal and
# clear the API key and the webhook secret from Admin > Payment Settings, where
# they are stored ENCRYPTED with the application key. Anything saved there wins;
# an empty field here is used whenever the database has no value for it, so an
# existing .env-only deployment keeps working exactly as before.
#
# The page never prints a stored value into the form. It shows a masked hint
# only, and the "Show" action renders a value once on its own no-store page.
#
# ABLINER_API_KEY and ABLINER_WEBHOOK_SECRET are real credentials: keep them
# out of version control and out of any shared log. Rotate them if they are
# exposed. If APP_KEY is ever rotated, stored credentials become unreadable and
# the page will say so and ask for them to be re-entered.
# ---------------------------------------------------------------------------
# API key from https://abliner.net/dashboard/api-keys. Starts with tsl_live_.
ABLINER_API_KEY=
# Webhook signing secret from the same page. Starts with whsec_. It is REQUIRED:
# without it Abliner answers 400 webhook_secret_required and sends no USSD push.
# The same secret signs every outbound deposit request and verifies the
# x-webhook-signature header on inbound callbacks.
ABLINER_WEBHOOK_SECRET=
# The public HTTPS URL Abliner posts payment callbacks to. Leave blank to let the
# app fall back to its own route, then copy the value shown on the settings page.
ABLINER_WEBHOOK_URL=
# Re-read a transaction from the API before trusting a "completed" callback.
# Keep this true in production: it is what stops a forged callback from marking
# an order as paid.
ABLINER_VERIFY_ON_WEBHOOK=true
